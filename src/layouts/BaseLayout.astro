---
import "../styles/global.css";
import { localizePath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  image?: string;
}

const {
  locale,
  title = "Павло Баша — Mobile Developer & Digital Product Builder",
  description = "Портфоліо Павла Баші: мобільні продукти, вебсайти та цифрові рішення від ідеї до релізу.",
  image = "/images/projects/metalcash.png",
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ukUrl = Astro.site ? new URL(localizePath(Astro.url.pathname, "uk"), Astro.site) : undefined;
const enUrl = Astro.site ? new URL(localizePath(Astro.url.pathname, "en"), Astro.site) : undefined;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="color-scheme" content="light" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:locale" content={locale === "uk" ? "uk_UA" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    {canonical && <link rel="canonical" href={canonical} />}
    {ukUrl && <link rel="alternate" hreflang="uk" href={ukUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {enUrl && <link rel="alternate" hreflang="x-default" href={enUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />

    <script>
      const revealElements = document.querySelectorAll("[data-reveal]");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.12 },
        );

        revealElements.forEach((element) => observer.observe(element));
      } else {
        revealElements.forEach((element) => element.classList.add("is-visible"));
      }

      document.querySelectorAll("[data-language]").forEach((link) => {
        link.addEventListener("click", () => {
          const locale = link.getAttribute("data-language");
          if (!locale) return;
          document.cookie = `site_locale=${locale}; Max-Age=31536000; Path=/; SameSite=Lax`;
        });
      });

      const deviceScenes = document.querySelectorAll<HTMLElement>("[data-scroll-devices]");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (deviceScenes.length > 0) {
        const deviceStates = Array.from(deviceScenes, (scene) => ({
          scene,
          current: 0,
          target: 0,
        }));
        let animationFrame = 0;
        let previousFrame = performance.now();

        const readProgress = (scene: HTMLElement) => {
          if (reducedMotion) return 0.65;

          const hero = scene.closest<HTMLElement>(".hero");
          if (!hero) return 0;

          const distance = Math.max(Math.min(hero.offsetHeight * 0.42, window.innerHeight * 0.32), 1);
          return Math.min(Math.max(window.scrollY / distance, 0), 1);
        };

        const animateDevices = (time: number) => {
          const elapsed = Math.min(time - previousFrame, 64);
          const smoothing = 1 - Math.exp(-elapsed / 55);
          let unsettled = false;
          previousFrame = time;

          for (const state of deviceStates) {
            state.current += (state.target - state.current) * smoothing;

            if (Math.abs(state.target - state.current) < 0.0005) {
              state.current = state.target;
            } else {
              unsettled = true;
            }

            state.scene.style.setProperty("--device-scroll", state.current.toFixed(4));
          }

          animationFrame = unsettled ? window.requestAnimationFrame(animateDevices) : 0;
        };

        const scheduleDeviceUpdate = () => {
          for (const state of deviceStates) {
            state.target = readProgress(state.scene);
          }

          if (animationFrame) return;
          previousFrame = performance.now();
          animationFrame = window.requestAnimationFrame(animateDevices);
        };

        for (const state of deviceStates) {
          state.target = readProgress(state.scene);
          state.current = state.target;
          state.scene.style.setProperty("--device-scroll", state.current.toFixed(4));
        }

        if (!reducedMotion) {
          window.addEventListener("scroll", scheduleDeviceUpdate, { passive: true });
          window.addEventListener("resize", scheduleDeviceUpdate);
        }
      }

      document.querySelectorAll<HTMLElement>("[data-project-carousel]").forEach((carousel) => {
        const track = carousel.querySelector<HTMLElement>(".projects__track");
        const primaryGroup = carousel.querySelector<HTMLElement>(".projects__group");
        if (!track || !primaryGroup) return;

        const desktopLayout = window.matchMedia("(min-width: 901px)");
        let groupWidth = primaryGroup.getBoundingClientRect().width;
        let offset = 0;
        let previousTime = performance.now();
        let frame = 0;
        let dragging = false;
        let hovered = false;
        let focused = false;
        let startX = 0;
        let startOffset = 0;
        let dragDistance = 0;
        let suppressClick = false;

        const normalizeOffset = (value: number) => {
          if (groupWidth <= 0) return 0;
          return ((value % groupWidth) + groupWidth) % groupWidth;
        };

        const render = () => {
          track.style.transform = `translate3d(${-offset}px, 0, 0)`;
        };

        const animate = (time: number) => {
          const elapsed = Math.min(time - previousTime, 64);
          previousTime = time;

          if (
            desktopLayout.matches &&
            !reducedMotion &&
            !dragging &&
            !hovered &&
            !focused &&
            !document.hidden
          ) {
            offset = normalizeOffset(offset + elapsed * 0.026);
            render();
          }

          frame = desktopLayout.matches ? window.requestAnimationFrame(animate) : 0;
        };

        const startAnimation = () => {
          if (frame || !desktopLayout.matches) return;
          previousTime = performance.now();
          frame = window.requestAnimationFrame(animate);
        };

        const updateDimensions = () => {
          groupWidth = primaryGroup.getBoundingClientRect().width;
          offset = normalizeOffset(offset);

          if (desktopLayout.matches) {
            render();
            startAnimation();
          } else {
            if (frame) window.cancelAnimationFrame(frame);
            frame = 0;
            track.style.removeProperty("transform");
          }
        };

        const finishDrag = (event: PointerEvent, cancelled = false) => {
          if (!dragging) return;

          dragging = false;
          carousel.classList.remove("is-dragging");
          hovered = event.pointerType === "mouse" && carousel.matches(":hover");

          if (carousel.hasPointerCapture(event.pointerId)) {
            carousel.releasePointerCapture(event.pointerId);
          }

          if (!cancelled && dragDistance > 6) {
            suppressClick = true;
            window.setTimeout(() => {
              suppressClick = false;
            }, 0);
          }
        };

        carousel.addEventListener("pointerdown", (event) => {
          if (!desktopLayout.matches || (event.pointerType === "mouse" && event.button !== 0)) return;

          dragging = true;
          dragDistance = 0;
          startX = event.clientX;
          startOffset = offset;
          carousel.classList.add("is-dragging");

          try {
            carousel.setPointerCapture(event.pointerId);
          } catch {
            // Synthetic events used by tests do not create an active pointer.
          }
        });

        carousel.addEventListener("pointermove", (event) => {
          if (!dragging) return;

          const delta = event.clientX - startX;
          dragDistance = Math.max(dragDistance, Math.abs(delta));
          offset = normalizeOffset(startOffset - delta);
          render();

          if (dragDistance > 6) event.preventDefault();
        });

        carousel.addEventListener("pointerup", (event) => finishDrag(event));
        carousel.addEventListener("pointercancel", (event) => finishDrag(event, true));

        carousel.addEventListener(
          "click",
          (event) => {
            if (suppressClick) {
              event.preventDefault();
              event.stopImmediatePropagation();
              suppressClick = false;
              return;
            }

            const target = event.target as HTMLElement;
            const decorativeCard = target.closest<HTMLElement>("[data-carousel-link]");
            const href = decorativeCard?.dataset.carouselLink;

            if (href) {
              event.preventDefault();
              window.location.assign(href);
            }
          },
          true,
        );

        carousel.addEventListener("pointerenter", (event) => {
          if (event.pointerType === "mouse") hovered = true;
        });

        carousel.addEventListener("pointerleave", (event) => {
          if (event.pointerType === "mouse" && !dragging) hovered = false;
        });

        carousel.addEventListener("focusin", () => {
          focused = true;
        });

        carousel.addEventListener("focusout", (event) => {
          focused = carousel.contains(event.relatedTarget as Node | null);
        });

        window.addEventListener("resize", updateDimensions);
        desktopLayout.addEventListener("change", updateDimensions);

        render();
        startAnimation();

        window.addEventListener(
          "pagehide",
          () => {
            if (frame) window.cancelAnimationFrame(frame);
          },
          { once: true },
        );
      });
    </script>
  </body>
</html>
