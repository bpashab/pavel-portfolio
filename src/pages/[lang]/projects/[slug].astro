---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Icon from "../../../components/Icon.astro";
import SocialLinks from "../../../components/SocialLinks.astro";
import { getProfile } from "../../../data/profile";
import { projects, type Project } from "../../../data/projects";
import { localizeProject } from "../../../data/projectTranslations";
import { locales, type Locale } from "../../../i18n/config";
import { getUi } from "../../../i18n/copy";

export const getStaticPaths = (() =>
  locales.flatMap((locale) =>
    projects.map((project) => ({
      params: { lang: locale, slug: project.slug },
      props: { locale, project },
    })),
  )) satisfies GetStaticPaths;

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project: baseProject } = Astro.props;
const project = localizeProject(baseProject, locale);
const currentIndex = projects.findIndex((item) => item.slug === baseProject.slug);
const nextProject = localizeProject(projects[(currentIndex + 1) % projects.length], locale);
const profile = getProfile(locale);
const copy = getUi(locale);
---

<BaseLayout
  locale={locale}
  title={`${project.title} — ${locale === "uk" ? "проєкт Павла Баші" : "a project by Pavel Basha"}`}
  description={project.shortDescription}
  image={project.image}
>
  <Header locale={locale} />

  <main>
    <section class={`project-hero project-hero--${project.tone} container`}>
      <div class="project-hero__meta" data-reveal>
        <span>{project.eyebrow}</span>
        <span>{project.year}</span>
      </div>
      <h1 data-reveal style="--delay: 70ms">{project.title}</h1>
      <p data-reveal style="--delay: 130ms">{project.shortDescription}</p>
      <a
        class="project-hero__link"
        href={project.url}
        target="_blank"
        rel="noreferrer"
        data-reveal
        style="--delay: 190ms"
      >
        {copy.caseStudy.openSite}
        <Icon name="external" size={19} />
      </a>
    </section>

    <div class="project-image container" data-reveal data-cover-frame>
      <div class="cover-loader" aria-hidden="true"><span></span></div>
      <img src={project.image} alt={project.imageAlt} width="1024" height="576" decoding="async" />
    </div>

    <section class="case container" aria-label={copy.caseStudy.descriptionLabel}>
      <div class="case__intro" data-reveal>
        <p class="eyebrow">{copy.caseStudy.about}</p>
        <p>{project.introduction}</p>
      </div>

      <div class="case__columns">
        <article data-reveal>
          <span>01</span>
          <h2>{copy.caseStudy.challenge}</h2>
          <p>{project.challenge}</p>
        </article>
        <article data-reveal style="--delay: 90ms">
          <span>02</span>
          <h2>{copy.caseStudy.solution}</h2>
          <p>{project.solution}</p>
        </article>
      </div>

      <div class="capabilities">
        <div data-reveal>
          <p class="eyebrow">{copy.caseStudy.capabilities}</p>
          <h2>{copy.caseStudy.capabilitiesTitle}</h2>
        </div>
        <ol>
          {
            project.capabilities.map((capability, index) => (
              <li data-reveal style={`--delay: ${(index % 3) * 60}ms`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {capability}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="next-project">
      <a href={`/${locale}/projects/${nextProject.slug}/`} class="container">
        <span>{copy.caseStudy.nextProject}</span>
        <strong>{nextProject.title}</strong>
        <span class="next-project__arrow"><Icon name="arrow" size={30} /></span>
      </a>
    </section>
  </main>

  <footer class="container">
    <span>© {new Date().getFullYear()} {profile.name} · Software Developer</span>
    <SocialLinks links={profile.socials} compact />
  </footer>
</BaseLayout>

<style>
  .project-hero {
    --accent: #b97936;
    padding-block: clamp(5rem, 10vw, 9rem) clamp(3rem, 6vw, 5rem);
  }

  .project-hero--lime {
    --accent: #879d23;
  }

  .project-hero--rose {
    --accent: #bd604d;
  }

  .project-hero__meta {
    display: flex;
    gap: 0.8rem;
    color: var(--muted);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-hero__meta span + span::before {
    margin-right: 0.8rem;
    content: "·";
  }

  h1 {
    margin: 1.4rem 0 1.8rem;
    font-family: var(--display);
    font-size: clamp(5rem, 14vw, 12rem);
    font-weight: 700;
    letter-spacing: -0.08em;
    line-height: 0.78;
  }

  .project-hero > p {
    max-width: 720px;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    line-height: 1.6;
  }

  .project-hero__link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 2rem;
    padding: 0.85rem 1rem 0.85rem 1.2rem;
    color: var(--paper);
    font-size: 0.78rem;
    font-weight: 700;
    text-decoration: none;
    background: var(--ink);
    border-radius: 999px;
    transition:
      gap 180ms ease,
      background 180ms ease;
  }

  .project-hero__link:hover {
    gap: 1.15rem;
    background: var(--accent);
  }

  .project-hero__link:focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 4px;
  }

  .project-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #ddd8cd;
    border-radius: 1.8rem;
    box-shadow: 0 35px 100px rgb(45 38 27 / 0.14);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case {
    padding-block: clamp(6rem, 12vw, 11rem);
  }

  .case__intro {
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: 3rem;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .case__intro > p:last-child {
    max-width: 850px;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(2rem, 4.4vw, 4.4rem);
    font-weight: 620;
    letter-spacing: -0.045em;
    line-height: 1.08;
  }

  .case__columns {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(2rem, 8vw, 8rem);
    padding-block: clamp(4rem, 8vw, 7rem);
    border-block: 1px solid var(--line);
  }

  .case__columns article {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 1rem;
  }

  .case__columns article > span {
    padding-top: 0.5rem;
    color: var(--muted);
    font-size: 0.65rem;
  }

  .case__columns h2 {
    margin: 0 0 1rem;
    font-family: var(--display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 680;
    letter-spacing: -0.04em;
  }

  .case__columns p {
    grid-column: 2;
    margin: 0;
    color: var(--muted);
    line-height: 1.75;
  }

  .capabilities {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 8vw, 8rem);
    padding-top: clamp(5rem, 10vw, 9rem);
  }

  .capabilities h2 {
    max-width: 500px;
    margin: 0;
    font-family: var(--display);
    font-size: clamp(3rem, 6vw, 5.8rem);
    font-weight: 680;
    letter-spacing: -0.06em;
    line-height: 0.92;
  }

  .capabilities ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .capabilities li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 0.8rem;
    padding-block: 1.35rem;
    font-size: clamp(1rem, 2vw, 1.3rem);
    border-top: 1px solid var(--line);
  }

  .capabilities li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .capabilities li span {
    color: var(--muted);
    font-size: 0.65rem;
  }

  .next-project {
    background: var(--ink);
  }

  .next-project a {
    position: relative;
    display: grid;
    min-height: 390px;
    align-content: center;
    color: var(--paper);
    text-decoration: none;
  }

  .next-project a > span:first-child {
    margin-bottom: 0.6rem;
    color: #a7a59d;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .next-project strong {
    font-family: var(--display);
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 700;
    letter-spacing: -0.07em;
    line-height: 0.9;
  }

  .next-project__arrow {
    position: absolute;
    top: 50%;
    right: 0;
    display: grid;
    place-items: center;
    width: 4.5rem;
    aspect-ratio: 1;
    color: var(--ink);
    background: var(--paper);
    border-radius: 50%;
    transform: translateY(-50%) rotate(-35deg);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .next-project a:hover .next-project__arrow {
    transform: translateY(-50%) rotate(0deg) scale(1.08);
  }

  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 7rem;
    color: var(--muted);
    font-size: 0.72rem;
  }

  @media (max-width: 760px) {
    .case__intro,
    .case__columns,
    .capabilities {
      grid-template-columns: 1fr;
    }

    .case__intro {
      gap: 1rem;
    }

    .case__columns {
      gap: 4rem;
    }

    .next-project a {
      min-height: 300px;
    }

    .next-project__arrow {
      top: auto;
      right: 1rem;
      bottom: 2rem;
      width: 3.5rem;
      transform: rotate(-35deg);
    }

    .next-project a:hover .next-project__arrow {
      transform: rotate(0deg);
    }
  }
</style>
